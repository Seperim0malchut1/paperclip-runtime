{
  "name": "@seperim0malchut1/paperclip-runtime",
  "version": "1.0.0",
  "description": "Secure, self-healing runtime orchestration for agentic systems.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:stress": "vitest run tests/runtime-stress.test.ts",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist coverage",
    "dev": "tsx watch src/index.ts",
    "check": "npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
